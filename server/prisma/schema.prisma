generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PLACED
  PREPARING
  COMPLETED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  orders    Order[]

  @@index([createdAt])
}

model Order {
  id             String      @id @default(cuid())
  storeId        String
  status         OrderStatus @default(PLACED)
  createdAt      DateTime    @default(now())
  theTotalAmount Decimal     @db.Decimal(10, 2)
  userId         String?
  user           User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          OrderItem[]

  @@index([storeId])
  @@index([createdAt])
  @@index([storeId, createdAt])
  @@index([userId])
}

model OrderItem {
  id       String @id @default(cuid())
  itemId   String
  orderId  String
  quantity Int
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderArchive {
  id              String      @id @default(cuid())
  storeId         String
  userId          String

  theTotalAmount  Decimal     @db.Decimal(10, 2)

  status          OrderStatus

  createdAt       DateTime
  archivedAt      DateTime    @default(now())
  items           Json

  @@index([storeId])
  @@index([createdAt])
  @@index([storeId, createdAt])
  @@index([archivedAt])
}
